{
  "schemaVersion": 1,
  "id": "serverhealth",
  "version": "${version}",
  "name": "Server Health",
  "description": "Reports this server's tick time and player count to the host's capacity service, which uses them to decide when new players may join.",
  "authors": [
    "BenjaminDanker"
  ],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.silver.serverhealth.ServerHealthMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
