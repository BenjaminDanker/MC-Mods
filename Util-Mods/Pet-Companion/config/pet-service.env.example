# Install as an owner-readable environment file outside the repository.
# Required secrets intentionally have no example values.
PET_SERVICE_TOKEN=
PET_DB_USER=
PET_DB_PASSWORD=

# Confirm the approved Raspberry Pi MariaDB database before enabling writes.
PET_DB_JDBC_URL=jdbc:mariadb://127.0.0.1:3306/minecraft

# Loopback is the safe default. Wildcard IPv4/IPv6 binds are rejected. Use one private
# interface only with reviewed source-address firewall rules.
PET_SERVICE_BIND_ADDRESS=127.0.0.1
PET_SERVICE_PORT=8787
PET_SERVICE_BACKLOG=64
PET_SERVICE_WORKER_THREADS=4
PET_SERVICE_WORKER_QUEUE=128
PET_SERVICE_SHUTDOWN_GRACE_SECONDS=10

# Emergency AI kill switch. False preserves authority, adoption, placement, sleep, and recall.
# Restart the service after changing this value.
PET_AI_ENABLED=true

# Explicit initial allowlist. Only these two identifiers are accepted; remove one to disable it.
PET_ALLOWED_SPECIES=minecraft:cat,minecraft:wolf

# Raw player/pet dialogue is redacted after this many days; summaries remain authoritative.
PET_RAW_TEXT_RETENTION_DAYS=7

# Billing is opt-in so development can run without production secrets. When enabled,
# use environment-specific Stripe test/live values and a unique random link pepper.
PET_STRIPE_ENABLED=false
# AI allowance is the estimated Stripe net for one subscription period.
# Formula: gross - (gross * payment %) - fixed payment fee - (gross * Billing %).
PET_SUBSCRIPTION_GROSS_USD=2.00
PET_STRIPE_PAYMENT_PERCENT=2.9
PET_STRIPE_FIXED_FEE_USD=0.30
PET_STRIPE_BILLING_PERCENT=0.7
# Development/staging-only substitute for Stripe entitlement. Keep disabled in production.
PET_DUMMY_SUBSCRIPTION_ENABLED=false
PET_DUMMY_SUBSCRIPTION_OWNER_UUID=
PET_STRIPE_PRICE_ID=
PET_STRIPE_SECRET_KEY=
PET_STRIPE_WEBHOOK_SECRET=
PET_ACCOUNT_LINK_PEPPER=
PET_STRIPE_PAYMENT_GRACE_DAYS=3
PET_ACCOUNT_LINK_TTL_MINUTES=15

# HTTPS origin used for adoption Checkout URLs, Checkout success, and cancellation pages.
# The reverse proxy must expose only /checkout/* and the exact signed webhook route.
PET_PUBLIC_BASE_URL=https://mc-multi-world.space

# Keep these deliberately small to protect the MariaDB host and Minecraft workloads.
PET_DB_POOL_MAXIMUM=4
PET_DB_POOL_MINIMUM_IDLE=1
PET_DB_CONNECTION_TIMEOUT_MS=3000
PET_DB_VALIDATION_TIMEOUT_MS=1000

# Optional Qdrant vector index. MariaDB remains authoritative; leave disabled until the
# approved Qdrant endpoint and embedding model/dimension are staged.
PET_QDRANT_ENABLED=false
PET_QDRANT_URL=http://127.0.0.1:6333
PET_QDRANT_COLLECTION=aipets_memories
PET_QDRANT_DIMENSION=1536
PET_QDRANT_API_KEY=
PET_QDRANT_TIMEOUT_MS=2000

# OpenAI is the primary provider for chat, embeddings, and moderation. Keep keys outside the repo.
# OpenAI reports tokens, not dollars, so its calls are priced with the per-million prices below;
# a call served by OpenRouter is charged OpenRouter's reported usage.cost instead.
PET_OPENAI_API_KEY=
PET_OPENAI_BASE_URL=https://api.openai.com
PET_EMBEDDING_MODEL=text-embedding-3-small
PET_EMBEDDING_DIMENSION=1536
PET_AI_PRICE_DIALOGUE_INPUT_PER_MILLION=0.10
PET_AI_PRICE_DIALOGUE_CACHED_PER_MILLION=0.01
PET_AI_PRICE_DIALOGUE_OUTPUT_PER_MILLION=0.50
PET_AI_PRICE_EMBEDDING_INPUT_PER_MILLION=0.02

# Optional OpenRouter key. When set, a failed OpenAI chat or embedding call (outage, rate limit,
# timeout) is retried once on the same model through OpenRouter (embedding vectors are identical,
# so they stay interchangeable in the index). Set PET_OPENROUTER_FALLBACK=false to disable.
# Moderation has no fallback: if it is unavailable the message is let through. Best effort: this
# path may be rate limited on new OpenRouter accounts.
# Every fallback and bypass is reported three ways. The log line is the alert: it starts with
# ALERT AI_FALLBACK_USED, ALERT AI_FALLBACK_FAILED (ERROR level) or ALERT AI_MODERATION_BYPASSED,
# followed by JSON, so `grep ALERT` finds every one; counters
# aipets_ai_fallback_chat_used_total, aipets_ai_fallback_embedding_used_total,
# aipets_ai_fallback_failed_total and aipets_moderation_bypassed_total on /health/metrics; and an
# ai_usage row whose model starts with FALLBACK:openrouter:.
PET_OPENROUTER_API_KEY=
PET_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PET_OPENROUTER_FALLBACK=true

# Dialogue is opt-in because it makes paid model calls. Each turn makes two parallel calls: the
# pet's voice (character prompt, reply/action/feelings) and memory bookkeeping (owner reports,
# self-model evidence, a tentative reading of the owner). A failed bookkeeping call never blocks
# the reply. Input safety is deterministic local checks plus free omni-moderation, which overlaps
# the model calls; a flagged message discards the reply.
PET_DIALOGUE_ENABLED=false
PET_DIALOGUE_MODEL=gpt-6-luna
PET_MODERATION_MODEL=omni-moderation-latest
# Only these omni-moderation categories block a message. Everything else passes, including
# self-harm (so the pet can respond to someone who needs it) and ordinary harassment (so the pet
# can react to a rude owner). Valid names: harassment, harassment/threatening, hate,
# hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions,
# sexual, sexual/minors, violence, violence/graphic.
PET_MODERATION_BLOCKED_CATEGORIES=sexual,sexual/minors,hate,hate/threatening
# "none" disables reasoning on OpenAI reasoning models; leave blank to omit the parameter.
PET_DIALOGUE_REASONING_EFFORT=none
# Structured model for memory bookkeeping; blank disables owner-report memory proposals.
PET_MEMORY_MODEL=gpt-6-luna
PET_DIALOGUE_TIMEOUT_MS=10000
# Legacy reply-count safety ceiling (production quota is the period AI-dollar budget above).
# Leave at 100 for compatibility in older deployments; new runtime wiring uses no practical ceiling.
PET_DIALOGUE_DAILY_REPLY_CAP=100
# Sparse planner for unsolicited pet intents after verified events.
PET_PLANNER_MODEL=gpt-6-luna

# Temporary per-call budget holds (USD). A hold reserves headroom while a call is in flight and is
# released when the call settles with its real cost.
PET_AI_HOLD_DIALOGUE_USD=0.003
PET_AI_HOLD_CONSOLIDATION_USD=0.005
PET_AI_HOLD_PLANNING_USD=0.002
PET_AI_HOLD_EMBEDDING_USD=0.0002

# Sleep consolidation is separately opt-in. It uses the same bounded structured-output
# transport, but has its own model setting and only runs for eligible paid pets.
PET_CONSOLIDATION_ENABLED=false
PET_CONSOLIDATION_MODEL=gpt-6-luna

# Need-based, service-side sleep. These defaults permit multiple naps per day and a
# longer sleep after sustained wakefulness. Held/unloaded pets follow the same SQL clock.
PET_SLEEP_LOGOUT_DELAY_MINUTES=30
PET_SLEEP_MAX_AWAKE_MINUTES=960
PET_SLEEP_NAP_MINUTES=12
PET_SLEEP_LONG_MINUTES=40
PET_SLEEP_MIN_AWAKE_MINUTES=75
PET_SLEEP_ONLINE_FATIGUE_PER_HOUR=6
PET_SLEEP_OFFLINE_FATIGUE_PER_HOUR=1
PET_SLEEP_NAP_THRESHOLD=60
PET_SLEEP_LONG_THRESHOLD=85
PET_SLEEP_NAP_RECOVERY=45
PET_SLEEP_LONG_RECOVERY=85
