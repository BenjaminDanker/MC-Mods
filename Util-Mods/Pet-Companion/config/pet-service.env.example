# Install as an owner-readable environment file outside the repository.
# Required secrets intentionally have no example values.
PET_SERVICE_TOKEN=
PET_DB_USER=
PET_DB_PASSWORD=

# Confirm the approved Raspberry Pi MariaDB database before enabling writes.
PET_DB_JDBC_URL=jdbc:mariadb://127.0.0.1:3306/minecraft

# Loopback is the safe default. Wildcard IPv4/IPv6 binds are rejected. Use one private
# interface only with reviewed source-address firewall rules.
PET_SERVICE_BIND_ADDRESS=127.0.0.1
PET_SERVICE_PORT=8787
PET_SERVICE_BACKLOG=64
PET_SERVICE_WORKER_THREADS=4
PET_SERVICE_WORKER_QUEUE=128
PET_SERVICE_SHUTDOWN_GRACE_SECONDS=10

# Emergency AI kill switch. False preserves authority, adoption, placement, sleep, and recall.
# Restart the service after changing this value.
PET_AI_ENABLED=true

# Explicit initial allowlist. Only these two identifiers are accepted; remove one to disable it.
PET_ALLOWED_SPECIES=minecraft:cat,minecraft:wolf

# Raw player/pet dialogue is redacted after this many days; summaries remain authoritative.
PET_RAW_TEXT_RETENTION_DAYS=7

# Billing is opt-in so development can run without production secrets. When enabled,
# use environment-specific Stripe test/live values and a unique random link pepper.
PET_STRIPE_ENABLED=false
PET_STRIPE_PRICE_ID=
PET_STRIPE_SECRET_KEY=
PET_STRIPE_WEBHOOK_SECRET=
PET_ACCOUNT_LINK_PEPPER=
PET_STRIPE_PAYMENT_GRACE_DAYS=3
PET_ACCOUNT_LINK_TTL_MINUTES=10

# HTTPS origin used for the no-input /pet link URL, Checkout success, and cancellation pages.
# The reverse proxy must expose only /checkout/* and the exact signed webhook route.
PET_PUBLIC_BASE_URL=https://pets.example.invalid

# Keep these deliberately small to protect the MariaDB host and Minecraft workloads.
PET_DB_POOL_MAXIMUM=4
PET_DB_POOL_MINIMUM_IDLE=1
PET_DB_CONNECTION_TIMEOUT_MS=3000
PET_DB_VALIDATION_TIMEOUT_MS=1000

# Optional Qdrant vector index. MariaDB remains authoritative; leave disabled until the
# approved Qdrant endpoint and embedding model/dimension are staged.
PET_QDRANT_ENABLED=false
PET_QDRANT_URL=http://127.0.0.1:6333
PET_QDRANT_COLLECTION=aipets_memories
PET_QDRANT_DIMENSION=1536
PET_QDRANT_API_KEY=
PET_QDRANT_TIMEOUT_MS=2000

# OpenAI is used only for compact memory-card/query embeddings. Keep this key outside the repo.
PET_OPENAI_API_KEY=
PET_OPENAI_BASE_URL=https://api.openai.com
PET_EMBEDDING_MODEL=text-embedding-3-small
PET_EMBEDDING_DIMENSION=1536
