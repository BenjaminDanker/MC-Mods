# Configure these in the Velocity process environment; do not copy secrets into plugin files.
# The token must match PET_SERVICE_TOKEN on the central pet service.
PET_SERVICE_TOKEN=

# Private/internal pet-service origin reachable from Velocity. No path, query, or credentials.
PET_SERVICE_BASE_URI=http://pet-service.internal:8787

# Total connect/request timeout for asynchronous presence delivery (1..30000 ms).
PET_PRESENCE_TIMEOUT_MS=3000
