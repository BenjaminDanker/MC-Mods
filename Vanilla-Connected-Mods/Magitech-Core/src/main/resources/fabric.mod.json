{
  "schemaVersion": 1,
  "id": "magitech",
  "version": "${version}",
  "name": "Magitech Core",
  "description": "The Magitech resource loop: Ley Crystals (gathered by benders at ley wells) and Deepsteel (drilled from deep veins).",
  "authors": [
    "BenjaminDanker"
  ],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.silver.magitech.MagitechCoreMod"
    ]
  },
  "mixins": ["magitech.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "polymer-core": ">=0.11.0",
    "polymer-resource-pack": ">=0.11.0",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "suggests": {
    "bending": "*",
    "portals": "*",
    "faction-lock": "*"
  }
}